# Copia este archivo a .env y completa los valores. .env no se sube a git.
# Vite solo expone al código las variables con prefijo VITE_.

# Backend de consulta (monolito-consulta)
VITE_API_URL=http://localhost:8090

# Firebase (Authentication del panel web, SCRUM-57)
# Valores de: Firebase console > Configuración del proyecto > Tus apps > Configuración del SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
