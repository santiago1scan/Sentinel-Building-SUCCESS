# Credenciales de la BD Docker "success" usadas por compose.yaml (raiz).
POSTGRES_DB=success
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

# Broker MQTT (solo TLS, puerto 8883). Antes de levantar: backend/mosquitto/gen-certs.sh e init.sh.
# MQTT_ADMIN_PASSWORD debe ser la misma con la que se ejecutó init.sh.
MQTT_ADMIN_PASSWORD=change_me_admin
# Cuenta del consumidor de telemetría (monolito-escucha). Se crea con provision_consumer.
MQTT_CONSUMER_USERNAME=escucha-consumer
MQTT_CONSUMER_PASSWORD=change_me_consumer
# Tokens de nodos para el bridge: "NODE-FLOOR-1=token1,NODE-FLOOR-2=token2"
SENTINEL_NODE_TOKENS=

# Firebase Authentication (panel web). El backend verifica el ID token con el id del proyecto;
# la API key NO se usa aquí: va solo en el .env del frontend (VITE_FIREBASE_API_KEY).
# Firebase console > Configuración del proyecto > General > ID del proyecto.
FIREBASE_PROJECT_ID=
# Correos autorizados a usar el panel, separados por coma. Vacío = cualquier usuario de Firebase.
FIREBASE_ADMIN_EMAILS=
