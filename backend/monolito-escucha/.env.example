# Base de datos compartida "success" (levantada con backend/sumothings_db/compose.yaml)
# Desde Docker usa host "postgres"; corriendo localmente usa "localhost".
DATABASE_URL=postgresql+asyncpg://admin:change_me@localhost:5432/success
APP_ENV=development

# Broker MQTT (TLS). Cuenta de solo suscripción creada con provision_consumer.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_FILE=../mosquitto/certs/ca.crt
MQTT_USERNAME=escucha-consumer
MQTT_PASSWORD=change_me_consumer
