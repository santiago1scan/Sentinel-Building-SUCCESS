# Base de datos compartida "success" (levantada con backend/sumothings_db/compose.yaml)
# Desde Docker usa host "postgres"; corriendo localmente usa "localhost".
DATABASE_URL=postgresql+asyncpg://admin:change_me@localhost:5432/success
APP_ENV=development

# Broker MQTT (TLS). Cuenta de administración creada por backend/mosquitto/init.sh.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_FILE=../mosquitto/certs/ca.crt
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=change_me_admin
BUILDING_CODE=SB-001

# Firebase Authentication (panel web). El backend verifica el ID token con el id del proyecto;
# la API key NO se usa aquí: va solo en el .env del frontend (VITE_FIREBASE_API_KEY).
# Firebase console > Configuración del proyecto > General > ID del proyecto.
FIREBASE_PROJECT_ID=
# Correos autorizados a usar el panel, separados por coma. Vacío = cualquier usuario de Firebase.
FIREBASE_ADMIN_EMAILS=
